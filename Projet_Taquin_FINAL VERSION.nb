    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>((Condition[
         $CellContext`tileButton[
          Pattern[$CellContext`n, 
           Blank[]], 
          Pattern[$CellContext`tile, 
           Blank[]], 
          Blank[], 
          Pattern[$CellContext`opts, 
           BlankNullSequence[]]], $CellContext`n == Max[$CellContext`tile]] := 
       Button[" ", Null, Background -> LightGray, Enabled -> 
         False]; $CellContext`tileButton[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`tile, 
          Blank[]], 
         Pattern[$CellContext`tfc, 
          Blank[]], 
         Pattern[$CellContext`labelsShown, 
          Blank[]], 
         Pattern[$CellContext`size, 
          Blank[]], 
         Pattern[$CellContext`opts, 
          BlankNullSequence[]]] := Button[
         If[$CellContext`labelsShown, 
          Show[
           Graphics[
            Inset[
             Part[$CellContext`tfc, $CellContext`n], {0, 0}, {0, 0}, 1]], 
           Graphics[{
             Text[
              Style[$CellContext`n, (500/$CellContext`size)/2], {0.5, 0.5}]}],
            PlotRange -> {{0, 1}, {0, 1}}, ImageSize -> 
           400/$CellContext`size], 
          Part[$CellContext`tfc, $CellContext`n]], 
         $CellContext`tileMove[$CellContext`n, $CellContext`tile], 
         FrameMargins -> 0, $CellContext`opts]; 
      SetAttributes[$CellContext`tileButton, 
        HoldRest]; $CellContext`borderingSquare[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`tile, 
          Blank[]]] := 
       Module[{$CellContext`posN, $CellContext`posMax, $CellContext`diff}, \
$CellContext`posN = Flatten[
            Position[$CellContext`tile, $CellContext`n]]; $CellContext`posMax = 
          Flatten[
            Position[$CellContext`tile, 
             Max[$CellContext`tile]]]; $CellContext`diff = 
          Abs[$CellContext`posN - $CellContext`posMax]; 
         And[Total[$CellContext`diff] == 1, Count[$CellContext`diff, 1] == 
           1]]; $CellContext`tileMove[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`tile, 
          Blank[]]] := If[
         $CellContext`borderingSquare[$CellContext`n, $CellContext`tile], 
         Unevaluated[$CellContext`tile] = 
