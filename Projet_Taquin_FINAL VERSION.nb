Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tileFaces", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ImagePartition", "[", 
       RowBox[{
        RowBox[{"Graphics", "[", 
         RowBox[{"{", "}"}], "]"}], ",", 
        RowBox[{
         RowBox[{"ImageDimensions", "[", 
          RowBox[{"Graphics", "[", 
           RowBox[{"{", "}"}], "]"}], "]"}], "/", "size"}]}], "]"}], "]"}]}], 
    ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"Grid", "[", 
     RowBox[{
      RowBox[{"Map", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tileButton", "[", 
          RowBox[{
          "#", ",", "puzzleGrid", ",", "tileFaces", ",", "showLabels", ",", 
           "size", ",", "\[IndentingNewLine]", 
           RowBox[{"Enabled", "->", 
            RowBox[{"Not", "[", 
             RowBox[{"OrderedQ", "[", 
              RowBox[{"Flatten", "[", "puzzleGrid", "]"}], "]"}], "]"}]}], ",",
            "\[IndentingNewLine]", 
           RowBox[{"Appearance", "->", 
            RowBox[{"If", "[", 
             RowBox[{"noEdges", ",", "Automatic", ",", "\"\<Frameless\>\""}], 
             "]"}]}]}], "]"}], "&"}], ",", "\[IndentingNewLine]", 
        "puzzleGrid", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], ",", 
      RowBox[{"Frame", "->", "All"}], ",", 
      RowBox[{"Spacings", "->", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"size", ",", "3"}], "}"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"3", ",", "6"}], "]"}], ",", 
     RowBox[{"ControlType", "->", "PopupMenu"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"noEdges", ",", "False", ",", "\"\<show edges\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"True", ",", "False"}], "}"}], ",", 
     RowBox[{"ControlType", "->", "None"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"showLabels", ",", "True", ",", "\"\<show labels\>\""}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"True", ",", "False"}], "}"}], ",", 
     RowBox[{"ControlType", "->", "None"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Randomize puzzle\>\"", ",", 
     RowBox[{"puzzleGrid", "=", 
      RowBox[{"Partition", "[", 
       RowBox[{
        RowBox[{"RandomSample", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"size", "^", "2"}], "]"}], ",", 
          RowBox[{"size", "^", "2"}]}], "]"}], ",", "size"}], "]"}]}]}], 
    "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"puzzleGrid", ",", 
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"RandomSample", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"3", "^", "2"}], "]"}], ",", 
           RowBox[{"3", "^", "2"}]}], "]"}], ",", "3"}], "]"}]}], "}"}], ",", 
     "None"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Initialization", ":>", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"tileButton", "[", 
         RowBox[{"n_", ",", "tile_", ",", "_", ",", "opts___"}], "]"}], "/;", 
        RowBox[{"n", "==", 
         RowBox[{"Max", "[", "tile", "]"}]}]}], ":=", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\< \>\"", ",", "Null", ",", 
         RowBox[{"Background", "->", "LightGray"}], ",", 
         RowBox[{"Enabled", "->", "False"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tileButton", "[", 
        RowBox[{
        "n_", ",", "tile_", ",", "tfc_", ",", "labelsShown_", ",", "size_", ",",
          "opts___"}], "]"}], ":=", 
       RowBox[{"Button", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{"labelsShown", ",", 
           RowBox[{"Show", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Graphics", "[", 
              RowBox[{"Inset", "[", 
               RowBox[{
                RowBox[{"tfc", "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}], "]"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"Graphics", "[", 
              RowBox[{"{", 
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{"n", ",", 
                   RowBox[{
                    RowBox[{"500", "/", "size"}], "/", "2"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}], "}"}], "]"}], ",",
              "\[IndentingNewLine]", 
             RowBox[{"PlotRange", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
             RowBox[{"ImageSize", "->", 
              RowBox[{"400", "/", "size"}]}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"tfc", "[", 
            RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"tileMove", "[", 
          RowBox[{"n", ",", "tile"}], "]"}], ",", 
         RowBox[{"FrameMargins", "->", "0"}], ",", "opts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SetAttributes", "[", 
       RowBox[{"tileButton", ",", "HoldRest"}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"borderingSquare", "[", 
        RowBox[{"n_", ",", "tile_"}], "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"posN", ",", "posMax", ",", "diff"}], "}"}], ",", 
         RowBox[{
          RowBox[{"posN", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"tile", ",", "n"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"posMax", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Position", "[", 
             RowBox[{"tile", ",", 
              RowBox[{"Max", "[", "tile", "]"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"diff", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{"posN", "-", "posMax"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Total", "[", "diff", "]"}], "==", "1"}], ")"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{"diff", ",", "1"}], "]"}], "==", "1"}], ")"}]}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tileMove", "[", 
        RowBox[{"n_", ",", "tile_"}], "]"}], ":=", 
       RowBox[{"(", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"borderingSquare", "[", 
           RowBox[{"n", ",", "tile"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Unevaluated", "[", "tile", "]"}], "=", 
           RowBox[{"tile", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"n", "->", 
               RowBox[{"Max", "[", "tile", "]"}]}], ",", 
              RowBox[{
               RowBox[{"Max", "[", "tile", "]"}], "->", "n"}]}], "}"}]}]}]}], 
         "]"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"SetAttributes", "[", 
       RowBox[{"tileMove", ",", "HoldRest"}], "]"}], ";"}], ")"}]}]}], 
  "]"}]], "Input",
