        Typeset`keyframeList$$}, "Body" :> ($CellContext`tileFaces = Flatten[
          ImagePartition[
           Graphics[{}], ImageDimensions[
             Graphics[{}]]/$CellContext`size$$]]; Grid[
         Map[$CellContext`tileButton[#, $CellContext`puzzleGrid$$, \
$CellContext`tileFaces, $CellContext`showLabels$$, $CellContext`size$$, 
           Enabled -> Not[
             OrderedQ[
              Flatten[$CellContext`puzzleGrid$$]]], Appearance -> 
           If[$CellContext`noEdges$$, Automatic, 
             "Frameless"]]& , $CellContext`puzzleGrid$$, {2}], Frame -> All, 
         Spacings -> {1, 1}]), 
      "Specifications" :> {{{$CellContext`size$$, 3}, {3, 4, 5, 6}, 
