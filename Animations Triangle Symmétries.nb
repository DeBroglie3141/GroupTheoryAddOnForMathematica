Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AnimateTransformations", "[", 
     RowBox[{"transList_List", ",", 
      RowBox[{"stepDur", ":", "5"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "transList", "]"}]}], ",", "duration"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"duration", "=", 
        RowBox[{"stepDur", "*", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Animate", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"transfos", ",", "\[IndentingNewLine]", 
             RowBox[{"Fold", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"GeometricTransformation", "[", 
                  RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ")"}], ",", 
               "\[IndentingNewLine]", "triangle", ",", "\[IndentingNewLine]", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"transList", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"Min", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], "*", "stepDur"}]}], ")"}],
                     "/", "stepDur"}]}], "]"}]}], "]"}], "]"}], ",", 
