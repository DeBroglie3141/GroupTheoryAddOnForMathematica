Cell[TextData[{
 "En faisant correspondre l\[CloseCurlyQuote]addition de n \[AGrave] un \
intervalle de n semitons, on voit que les notes sont un exemple du groupe \
cyclique d\[CloseCurlyQuote]ordre 12, not\[EAcute] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "12"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e9e5d1bc-2158-9e46-9ceb-4a758ccd80ed"],
 ".\nOn peut ainsi composer deux intervalles pour en obtenir un nouveau, et \
on obtient le tableau suivant\[NonBreakingSpace]:"
}], "Text",
 CellChangeTimes->{{3.9651922851416035`*^9, 3.9651923477590313`*^9}, {
   3.965192379517084*^9, 3.9651924038661747`*^9}, {3.9651924758352795`*^9, 
   3.9651925029026585`*^9}, 3.965192542493252*^9, {3.9651933377923985`*^9, 
   3.9651934109164696`*^9}},ExpressionUUID->"c365710d-46c7-144e-99cd-\
d2e604e69750"],

