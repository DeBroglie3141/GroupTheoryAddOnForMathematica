Cell[TextData[{
 "Traditionnellement, on divise un octave en 12 notes : Do, Do#/R\[EAcute]\
\[Flat], R\[EAcute], R\[EAcute]#/Mi\[Flat], Mi, Fa, Fa#/Sol\[Flat], Sol, \
Sol#/La\[Flat], La, La#/Si\[Flat] et Si. Apr\[EGrave]s un octave, on \
recommence au Do. Ainsi, on peut assimiler les notes du piano \[AGrave] ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{},
     "Integers"], "/", "12"}], 
   TemplateBox[{},
    "Integers"]}]],ExpressionUUID->"cadecdd9-2c7d-4c42-9282-8995f868cdf2"],
 "."
}], "Text",
 CellChangeTimes->{{3.965191835171814*^9, 3.9651919009335976`*^9}, {
  3.9651919476714916`*^9, 
  3.965192155952919*^9}},ExpressionUUID->"e7e21fd7-77fb-a149-aa45-\
b07b5055e4c3"],

