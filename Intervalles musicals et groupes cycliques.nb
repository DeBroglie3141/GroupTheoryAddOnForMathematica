Cell[TextData[{
 "On remarque qu\[CloseCurlyQuote]on obtient tous les intervalles que pour 3 \
valeurs de n\[NonBreakingSpace]: il s\[CloseCurlyQuote]agit de 1, 5, 7 et 11. \
ON appelle math\[EAcute]matiquement ces valeurs les ",
 StyleBox["g\[EAcute]n\[EAcute]rateurs",
  FontWeight->"Bold"],
 " du groupe ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      TemplateBox[{},
       "Integers"], "/", "12"}], 
     TemplateBox[{},
      "Integers"]}], ",", "+"}], ")"}]],ExpressionUUID->
  "06c8f039-ddc7-fb49-ad36-19609b05cc65"],
 ". Les \[EAcute]l\[EAcute]ments du groupe sont dans un ordre bien \
d\[EAcute]termin\[EAcute], et ces dispositions sont nomm\[EAcute]s en th\
\[EAcute]orie de la musique. Pour n=1, il s\[CloseCurlyQuote]agit de la gamme \
chromatique, pour n = 5, il s\[CloseCurlyQuote]agit du cercle des quartes, \
pour n = 7, on parle du cercles des quintes et enfin pour n = 11 il s\
\[CloseCurlyQuote]agit de la gamme chromatique invers\[EAcute]e.\nLes cercles \
des quintes et des quartes sont souvent utilis\[EAcute]es en musique, car ils \
sonnent particuli\[EGrave]rement bien, e.g. Take me to the moon:"
}], "Text",
 CellChangeTimes->{{3.9651958635761433`*^9, 3.965195870318926*^9}, {
  3.965195924879242*^9, 3.9651959997464294`*^9}, {3.965196058233225*^9, 
  3.965196298853464*^9}, {3.9651964034562206`*^9, 3.9651965328027*^9}, {
  3.9651973542112217`*^9, 3.9651973635955772`*^9}, {3.96537846715246*^9, 
  3.9653784673077126`*^9}},ExpressionUUID->"e10bd7cc-edf8-9246-a448-\
c2a0601e22e2"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9652900656843224`*^9, 
  3.9652900663768425`*^9}},ExpressionUUID->"144df25e-458a-e844-abe7-\
0f96aac845dd"],

