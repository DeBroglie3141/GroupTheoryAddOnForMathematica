     RowBox[{"CyclicGroup", "[", "12", "]"}], "]"}], " ", "-", "1"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "11"}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "11"}], "]"}]}], "}"}]}]}], "]"}]], "Input",
