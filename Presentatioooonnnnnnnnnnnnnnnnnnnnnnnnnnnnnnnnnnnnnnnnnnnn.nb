Cell[TextData[{
 "1. Binary operation : ",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["a", "TI"], "*", 
        StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "a*b", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]], "Input",
  CellChangeTimes->{3.9653637894555283`*^9},ExpressionUUID->
  "2d668cd7-4696-0742-a422-097ef74c2137"],
 "\n2. Neutral element - Identity : ",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["a", "TI"], "*", 
        StyleBox["e", "TI"], "\[LongEqual]", 
        StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "a*e=a", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]], "Input",
  CellChangeTimes->{3.9653637894555283`*^9},ExpressionUUID->
  "04e5fa80-3728-4549-9755-bd023fd52258"],
 "\n3. Inverses : ",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        StyleBox["a", "TI"], "*", 
        SuperscriptBox[
         StyleBox["a", "TI"], "-1"], "\[LongEqual]", 
        StyleBox["e", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
    "a*a^{-1}=e", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]], "Input",
  CellChangeTimes->{3.9653637894555283`*^9},ExpressionUUID->
  "9178f968-6cdd-454a-b873-fcc745f49c2d"]
}], "Text",
