Cell[TextData[{
 "If we consider the operation of stacking two intervals on top of each other \
as a group operation, then this scale is isomorphic to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       TemplateBox[{},
        "Integers"], "/", "12"}], 
      TemplateBox[{},
       "Integers"]}], ",", "+"}], ")"}], "\[TildeFullEqual]", 
   SubscriptBox["C", "12"]}]],ExpressionUUID->
  "9f09f4bd-31a6-5c4a-916f-26b4fc62766a"],
 ", which we can represent in a Cailey table:"
}], "Text",
 CellChangeTimes->{{3.965381058643196*^9, 3.96538106243898*^9}, {
  3.96538124026713*^9, 3.96538127535931*^9}, {3.965381840179676*^9, 
  3.9653819268325844`*^9}},ExpressionUUID->"99bf8f00-6784-7342-b488-\
b089cdde3949"],

