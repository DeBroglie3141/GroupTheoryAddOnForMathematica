Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "b", " ", "and", " ", "c", " ", "numerically"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", "c"}], "}"}], "=", 
     RowBox[{"N", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"E", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Log", "[", "220", "]"}]}], "+", 
             RowBox[{"Log", "[", "440", "]"}]}], ")"}], "/", "12"}], ")"}]}], 
        ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "3"}], " ", 
              RowBox[{"Log", "[", "220", "]"}]}], "-", 
             RowBox[{"Log", "[", "440", "]"}]}], ")"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Log", "[", "220", "]"}], "-", 
           RowBox[{"Log", "[", "440", "]"}]}], ")"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "frequency", " ", "function"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"frequency", "[", 
     RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
    RowBox[{"b", "^", 
     RowBox[{"(", 
      RowBox[{"x", "+", "c"}], ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", "tones", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"tones", "=", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"With", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"k", "=", "n"}], "}"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Play", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Sin", "[", 
                RowBox[{"2", " ", "Pi", " ", "t", "*", 
                 RowBox[{"frequency", "[", 
                  RowBox[{"12.0", "*", 
                   RowBox[{"k", "/", "m"}]}], "]"}]}], "]"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"t", ",", "0", ",", "0.5"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"SampleRate", "->", "8000"}]}], "\[IndentingNewLine]", 
              "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"n", ",", "0", ",", 
             RowBox[{"m", "-", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Sound", "[", "tones", "]"}]}]}], "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "a", " ", "list", " ", "of", " ", "Sound", " ", "objects", " ", 
        "plays", " ", "in", " ", "sequence"}], "*)"}], "\[IndentingNewLine]", 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
