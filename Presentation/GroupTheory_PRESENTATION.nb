Cell[TextData[{
 "Let\[CloseCurlyQuote]s try to stack the same interval on top of itself many \
times, and see the intervals we get by this process:\n",
 StyleBox["Essayons de superposer un intervalle sur lui-m\[EHat]me un certain \
nombre de fois et observons le r\[EAcute]sultat:",
  FontSize->13]
}], "Text",
