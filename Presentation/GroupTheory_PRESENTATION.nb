Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AnimateTransformationsSquare", "[", 
     RowBox[{"transList_List", ",", 
      RowBox[{"stepDur_", ":", "5"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "transList", "]"}]}], ",", "duration"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"duration", "=", 
        RowBox[{"stepDur", "*", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Animate", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"transfos2", ",", "\[IndentingNewLine]", 
             RowBox[{"Fold", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"GeometricTransformation", "[", 
                  RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ")"}], ",", 
               "\[IndentingNewLine]", "square", ",", "\[IndentingNewLine]", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"transList", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"Min", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], "*", "stepDur"}]}], ")"}],
                     "/", "stepDur"}]}], "]"}]}], "]"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
                "]"}]}], "\[IndentingNewLine]", "]"}]}], 
            "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}]}], "}"}]}]}], "]"}],
          ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "duration"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AnimationRepetitions", "->", "1"}]}], "\[IndentingNewLine]",
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"AnimateTransformationsSquare", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sr3", ",", "ss2", ",", "ss4", ",", "sr3"}], "}"}], ",", "7"}], 
  "]"}]}], "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"bdb8393a-70f8-2944-93d5-9d8de4bfe963"],

