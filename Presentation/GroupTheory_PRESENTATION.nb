Cell[TextData[{
 "If we consider the operation of stacking two intervals on top of each other \
as a group operation, then this scale is isomorphic to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       TemplateBox[{},
        "Integers"], "/", "12"}], 
      TemplateBox[{},
       "Integers"]}], ",", "+"}], ")"}], "\[TildeFullEqual]", 
   SubscriptBox["C", "12"]}]],ExpressionUUID->
  "15d8e330-4cd8-234a-a6c0-ffe8b0234638"],
 ", which we can represent in a Cailey table:\n",
 StyleBox["Si l\[CloseCurlyQuote]on consid\[EGrave]re l\[CloseCurlyQuote]op\
\[EAcute]ration de superposer deux intervalles comme l\[CloseCurlyQuote]op\
\[EAcute]ration du groupe, alors l\[CloseCurlyQuote]ensemble est isomorphique \
\[AGrave] ",
  FontSize->15],
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       TemplateBox[{},
        "Integers"], "/", "12"}], 
      TemplateBox[{},
       "Integers"]}], ",", "+"}], ")"}], "\[TildeFullEqual]", 
   SubscriptBox["C", "12"]}]],
  FontSize->15,ExpressionUUID->"520b2b4e-919a-7641-bdd7-88bce1e297af"],
 StyleBox[", que l\[CloseCurlyQuote]on peut repr\[EAcute]senter dans la table \
de Cailey:",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.965381058643196*^9, 3.96538106243898*^9}, {
  3.96538124026713*^9, 3.96538127535931*^9}, {3.965381840179676*^9, 
  3.9653819268325844`*^9}, {3.965449981545559*^9, 
  3.965450050157812*^9}},ExpressionUUID->"6b3e9b85-1af8-be48-9002-\
7652f5630b61"],

