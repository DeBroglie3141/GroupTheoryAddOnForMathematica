Cell[CellGroupData[{

Cell["group properties of invertible matrices", "Section",
 CellChangeTimes->{
  3.699269664116198*^9, 3.70454748091461*^9, {3.704547516075143*^9, 
   3.7045475190812902`*^9}, {3.706294276733098*^9, 3.706294304716371*^9}, {
   3.9654494792312317`*^9, 3.9654494884776535`*^9}, {3.965449547015415*^9, 
   3.965449556411049*^9}},ExpressionUUID->"9a451bd9-053d-f142-9b73-\
ec9e1e2fd49e"],

Cell[TextData[{
 "Identity Matrix - ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "1"}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "5ee2ce12-c331-6748-920a-a45b0dd073a2"],
 "\nInverse - ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         SuperscriptBox[
          StyleBox["A", "TI"], "-1"], "\[LongEqual]", 
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell["2", "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]]}}], TraditionalForm]]],
            ")"}], "\[CenterDot]", 
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["-1", "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell["-1", "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["2", "InlineFormula"], " "}]]}}], TraditionalForm]]],
            ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell["0", "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["1", "InlineFormula"], " "}]]}}], TraditionalForm]]],
            ")"}], "\[LongEqual]", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "AA^{-1}= \\begin{pmatrix} 2 & 1 \\\\ 1 & 1 \\end{pmatrix} \\cdot \
\\begin{pmatrix} 1 & -1 \\\\ -1 & 2 \\end{pmatrix} = \\begin{pmatrix} 1 & 0 \
\\\\ 0 & 1 \\end{pmatrix}= I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "996b578d-bb07-fb4f-a6ad-e0bdd813455e"],
 "\nAssociativity- ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], 
             StyleBox["B", "TI"]}], ")"}], 
         StyleBox["C", "TI"], "\[LongEqual]", 
         StyleBox["A", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["B", "TI"], 
             StyleBox["C", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "(AB)C = A(BC)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d1adac9-f244-844a-8601-e30964c96103"],
 "\n\nNote: Matrices are not necessarily commutative\nThese properties are \
only satisfied when mapping to ",
 Cell[BoxData[
  TemplateBox[{},
   "Complexes"]],ExpressionUUID->"34239d7b-fe8b-0747-9e2f-75c0b06bd6ec"],
 " with multiplicative (x) operation"
}], "Text",
 CellChangeTimes->{{3.96544341847491*^9, 3.965443483986875*^9}, {
