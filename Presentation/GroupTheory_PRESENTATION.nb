Cell["\<\
The group operation will be composing two transformations. We then obtain a \
new transformation.\
\>", "Text",
 CellChangeTimes->{{3.965449596974987*^9, 
  3.9654496345597954`*^9}},ExpressionUUID->"340beadc-f4c1-9f44-bb40-\
a41795f2e0a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AnimateTransformations", "[", 
     RowBox[{"transList_List", ",", 
      RowBox[{"stepDur_", ":", "5"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "transList", "]"}]}], ",", "duration"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"duration", "=", 
        RowBox[{"stepDur", "*", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Animate", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", 
            RowBox[{"transfos", ",", "\[IndentingNewLine]", 
             RowBox[{"Fold", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"GeometricTransformation", "[", 
                  RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ")"}], ",", 
               "\[IndentingNewLine]", "triangle", ",", "\[IndentingNewLine]", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"transList", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"Min", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"t", "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], "*", "stepDur"}]}], ")"}],
                     "/", "stepDur"}]}], "]"}]}], "]"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "n"}], "}"}]}], "\[IndentingNewLine]", 
                "]"}]}], "\[IndentingNewLine]", "]"}]}], 
            "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.1"}], ",", "1.1"}], "}"}]}], "}"}]}]}], "]"}],
          ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "duration"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"AnimationRepetitions", "->", "1"}]}], "\[IndentingNewLine]",
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"AnimateTransformations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s3", ",", "s2", ",", "r1"}], "}"}], ",", "5"}], "]"}]}], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"01381bfa-86de-064a-96ce-8c50ccf0e067"],

