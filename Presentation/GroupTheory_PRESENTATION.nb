   3.965444780683876*^9, 3.965444781559143*^9}, 3.9654448132482243`*^9, 
   3.965447960421837*^9},ExpressionUUID->"8f060cdf-d2ed-9543-b0d3-\
5e3dcad681e8"],

Cell[TextData[{
 "\t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rule]", TraditionalForm], "errors" -> {}, "input" -> 
