Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IdentityElement", "[", "group_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"elems", ",", "n"}], "}"}], ",", 
     RowBox[{"Which", "[", 
      RowBox[{"(*", 
       RowBox[{"Groupes", " ", "finis", " ", "standard"}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "CyclicGroup"}], ",", "0",
        ",", 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "DihedralGroup"}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "SymmetricGroup"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AlternatingGroup"}]}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", 
       RowBox[{"(*", "PermutationGroup", "*)"}], 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "PermutationGroup"}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", 
       RowBox[{"(*", "AbelianGroup", "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AbelianGroup"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ValueQ", "[", 
           RowBox[{"AbelianGroupQ", "[", "_", "]"}], "]"}], "&&", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"AbelianGroupQ", "[", "group", "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"group", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Zn", ",", "+"}], ")"}], ":", 
         RowBox[{"groupe", " ", "additif", " ", "modulo", " ", "n"}]}], 
        "*)"}], 
       RowBox[{"MatchQ", "[", 
        RowBox[{"group", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<AddMod\>\"", ",", "n_"}], "}"}]}], "]"}], ",", "0", ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Zn", ",", "\[Times]"}], ")"}], " ", "mono\[IDoubleDot]de", 
         " ", "ou", " ", "groupe", " ", "multiplicatif"}], "*)"}], 
       RowBox[{"MatchQ", "[", 
        RowBox[{"group", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<MultMod\>\"", ",", "n_"}], "}"}]}], "]"}], ",", "1", ",", 
       RowBox[{"(*", 
        RowBox[{"Cas", " ", 
         RowBox[{"g\[EAcute]n\[EAcute]ral", ":", 
          RowBox[{
          "prendre", " ", "le", " ", "premier", " ", 
           "\[EAcute]l\[EAcute]ment", " ", "de", " ", "GroupElements"}]}]}], 
        "*)"}], "True", ",", 
       RowBox[{"First", "[", 
        RowBox[{"GroupElements", "[", "group", "]"}], "]"}]}], "]"}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IsIdentityByGroup", "[", 
    RowBox[{"group_", ",", "elem_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"elem", "===", 
     RowBox[{"IdentityElement", "[", "group", "]"}]}], ")"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IsIdentity", "[", 
     RowBox[{"list_List", ",", "elem_", ",", 
      RowBox[{"operation_", ":", "Plus"}]}], "]"}], "/;", 
    RowBox[{"MemberQ", "[", 
     RowBox[{"list", ",", "elem"}], "]"}]}], ":=", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"list", ",", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"operation", "[", 
          RowBox[{"elem", ",", "#"}], "]"}], ")"}], "==", "#"}], "&"}], 
      ")"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IsCenter", "[", 
     RowBox[{"group_", ",", "elem_"}], "]"}], "/;", 
    RowBox[{"GroupElementQ", "[", 
     RowBox[{"group", ",", "elem"}], "]"}]}], ":=", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"GroupElements", "[", "group", "]"}], ",", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"PermutationProduct", "[", 
          RowBox[{"elem", ",", "#"}], "]"}], ")"}], "==", 
        RowBox[{"PermutationProduct", "[", 
         RowBox[{"#", ",", "elem"}], "]"}]}], "&"}], ")"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GroupCenter", "[", "group_", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{
     RowBox[{"GroupElements", "[", "group", "]"}], ",", 
     RowBox[{
      RowBox[{"IsCenter", "[", 
       RowBox[{"group", ",", "#"}], "]"}], "&"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AbelianGroupQ", "[", "group_", "]"}], ":=", 
   RowBox[{
    RowBox[{"GroupElements", "[", "group", "]"}], "==", 
    RowBox[{"GroupCenter", "[", "group", "]"}]}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CayleyMultiplicationTable", "[", "group_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "elements", ",", "Operation", ",", "n", ",", "i", ",", "table", ",", 
       "opSymbol"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "D\[EAcute]tection", " ", "du", " ", "type", " ", "de", " ", "groupe", " ",
        "et", " ", "d\[EAcute]finition", " ", "de", " ", 
       RowBox[{"l", "'"}], "op\[EAcute]ration"}], "*)"}], 
     RowBox[{
      RowBox[{"Which", "[", 
       RowBox[{"(*", 
        RowBox[{"Groupe", " ", "ab\[EAcute]lien"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", "group", "]"}], "===", "AbelianGroup"}], "||", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ValueQ", "[", 
            RowBox[{"AbelianGroupQ", "[", "_", "]"}], "]"}], "&&", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"AbelianGroupQ", "[", "group", "]"}], "]"}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"elements", "=", 
          RowBox[{"Tuples", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"n", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "n", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"x", "+", "y"}], ",", "n"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"\"\<+ (mod \>\"", "<>", 
           RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupe", " ", "cyclique"}], "*)"}], 
        RowBox[{
