  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["G", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["E", "TI"], ",", "\[FivePointedStar]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> "G = (E, \\star{})", 
