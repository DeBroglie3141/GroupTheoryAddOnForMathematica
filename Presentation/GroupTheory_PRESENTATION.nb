Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"b", ",", "c"}], "}"}], "=", 
   RowBox[{"N", "@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Log", "[", "220", "]"}]}], "+", 
           RowBox[{"Log", "[", "440", "]"}]}], ")"}], "/", "12"}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "3"}], " ", 
            RowBox[{"Log", "[", "220", "]"}]}], "-", 
           RowBox[{"Log", "[", "440", "]"}]}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Log", "[", "220", "]"}], "-", 
         RowBox[{"Log", "[", "440", "]"}]}], ")"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"frequency", "[", 
   RowBox[{"x_", "?", "NumericQ"}], "]"}], ":=", 
  RowBox[{"b", "^", 
   RowBox[{"(", 
    RowBox[{"x", "+", "c"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Column", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Module", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", "tones", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tones", "=", 
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"With", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"k", "=", "n"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Play", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Sin", "[", 
                 RowBox[{"2", " ", "Pi", " ", "t", "*", 
                  RowBox[{"frequency", "[", 
                   RowBox[{"12.0", "*", 
                    RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"l", " ", "k"}], ",", "m"}], "]"}], "/", "m"}]}], 
                   "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
                RowBox[{"{", 
