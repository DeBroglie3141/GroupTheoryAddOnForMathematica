Cell[TextData[{
 "Traditionnaly in music theory an octave is deivided into 12 named \
intervals. After which we loop back to the unison, which means it behaves \
similarly to ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{},
     "Integers"], "/", "12"}], 
   TemplateBox[{},
    "Integers"]}]],ExpressionUUID->"4131f582-7f08-7244-a47b-07340f1856f7"],
 "\n",
 StyleBox["Un octave en th\[EAcute]orie de la musique est divis\[EAcute] en \
12 intervalles \[EAcute]gaux. Apr\[EGrave]s la 7e majeure, on revient \
\[AGrave] l\[CloseCurlyQuote]unison, ainsi l\[CloseCurlyQuote]ensemble des \
intervalles se comporte similairement \[AGrave] ",
  FontSize->13],
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TemplateBox[{},
     "Integers"], "/", "12"}], 
   TemplateBox[{},
    "Integers"]}]],
  FontSize->13,ExpressionUUID->"a831f1ed-83f7-6b47-96f8-1a94f8a475a6"]
}], "Text",
 CellChangeTimes->{
  3.6992697457019463`*^9, 3.6992698838436613`*^9, {3.70454744273073*^9, 
   3.704547443267602*^9}, {3.9652960251317616`*^9, 3.965296041183853*^9}, {
   3.9653643269460716`*^9, 3.9653643525727425`*^9}, {3.9653643992841587`*^9, 
   3.965364408117237*^9}, {3.9653808797100945`*^9, 3.9653809431385727`*^9}, {
