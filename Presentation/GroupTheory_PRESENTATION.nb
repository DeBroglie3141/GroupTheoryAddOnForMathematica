   3.9654489892978783`*^9}},ExpressionUUID->"032f5d67-4d83-4f42-9dea-\
18552563d7da"],

Cell[TextData[{
 "A set of elements and a binary operation  :  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["E", "TI"], TraditionalForm], "errors" -> {}, "input" -> "E", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cde2bd72-2f34-3b45-a3d4-912b30f4ceb9"],
 "  et ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[FivePointedStar]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\star b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec81a6a1-a902-5544-8789-71628c05ca01"]
}], "ItemNumbered",
 CellChangeTimes->{{3.965443628975155*^9, 3.9654436643534393`*^9}, 
   3.9654438943831615`*^9, 3.9654440138800697`*^9, {3.965444103352501*^9, 
   3.965444119233696*^9}, {3.9654443530748806`*^9, 3.965444405102089*^9}, {
   3.9654444782502003`*^9, 3.9654444830803127`*^9}, {3.965448386138788*^9, 
   3.9654483894482937`*^9}},ExpressionUUID->"93549070-fa27-9941-b956-\
125051e4db10"],

Cell[TextData[{
 "Closure : no matter how you group the steps, the outcome is always an \
element of  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["E", "TI"], TraditionalForm], "errors" -> {}, "input" -> "E", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ca2ab02-9f55-e542-8b0e-fb712a294386"],
 "  "
}], "ItemNumbered",
 CellChangeTimes->{{3.965443628975155*^9, 3.9654436643534393`*^9}, 
   3.9654438943831615`*^9, 3.9654440138800697`*^9, {3.965444103352501*^9, 
   3.965444119233696*^9}, {3.9654443530748806`*^9, 3.965444405102089*^9}, {
   3.9654444782502003`*^9, 3.9654444830803127`*^9}, {3.965448386138788*^9, 
   3.9654483969132576`*^9}, {3.965449141300558*^9, 
   3.9654492325575695`*^9}},ExpressionUUID->"be2b1666-a1b3-e14e-a624-\
5f3f935df7d3"],

Cell[TextData[{
 "Associativity : ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[FivePointedStar]", 
             StyleBox["b", "TI"]}], ")"}], "\[FivePointedStar]", 
         StyleBox["c", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[FivePointedStar]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["b", "TI"], "\[FivePointedStar]", 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "(a \\star b ) \\star c = a \\star (b \\star c)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a684b1d8-f393-2942-80b7-02380d5993d4"]
}], "ItemNumbered",
 CellChangeTimes->{{3.965443628975155*^9, 3.9654436989072247`*^9}, 
   3.96544389548328*^9, 3.9654440118823967`*^9, {3.965444126048626*^9, 
   3.965444131049965*^9}, 
   3.965444179079603*^9},ExpressionUUID->"dcf22800-6e66-a74f-b4bb-\
73f5a6334447"],

Cell[TextData[{
 "A neutral element :  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[FivePointedStar]", 
         StyleBox["e", "TI"], "\[LongEqual]", 
         StyleBox["e", "TI"], "\[FivePointedStar]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\star e = e \\star a = a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6340eb0e-1a71-6043-9b99-dc0865f732fe"]
}], "ItemNumbered",
 CellChangeTimes->{{3.965443628975155*^9, 3.9654437395068455`*^9}, 
   3.9654438967843304`*^9, 
   3.9654440152814713`*^9},ExpressionUUID->"016d4e88-273c-e74d-815a-\
f44c18ee5119"],

Cell[TextData[{
 "Every element has an inverse :  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[FivePointedStar]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "-1"], "\[LongEqual]", 
         StyleBox["e", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\star a^{-1} = e", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54477e6b-4690-634d-8d5c-46dd8a21e9db"]
}], "ItemNumbered",
 CellChangeTimes->{{3.965443628975155*^9, 3.9654437387595806`*^9}, {
