Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`noEdges$$ = 
    False, $CellContext`showLabels$$ = True, $CellContext`size$$ = 4, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`size$$], 4}, {3, 4, 5, 6}, ControlType -> 
      PopupMenu}, {{
       Hold[$CellContext`noEdges$$], False, "show edges"}, {True, False}, 
      ControlType -> None}, {{
       Hold[$CellContext`showLabels$$], True, "show labels"}, {True, False}, 
      ControlType -> None}, {
      Hold[
       Button["Randomise puzzle", $CellContext`puzzleGrid = Partition[
          RandomSample[
           
           Range[$CellContext`size$$^2], $CellContext`size$$^2], \
$CellContext`size$$]]], Manipulate`Dump`ThisIsNotAControl, ControlType -> 
      None}}, Typeset`size$$ = {
    161.00324640000002`, {77.48266613423672, 83.5232422220133}}, 
    Typeset`update$$ = 0, Typeset`initDone$$, Typeset`skipInitDone$$ = False, 
    Typeset`keyframeActionsQ$$ = False, Typeset`keyframeList$$ = {}}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`noEdges$$ = 
        False, $CellContext`showLabels$$ = True, $CellContext`size$$ = 4}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> ($CellContext`tileFaces = Flatten[
          ImagePartition[
           Graphics[{}], ImageDimensions[
             Graphics[{}]]/$CellContext`size$$]]; 
       If[Length[$CellContext`puzzleGrid] =!= $CellContext`size$$, \
$CellContext`puzzleGrid = Partition[
           RandomSample[
            
            Range[$CellContext`size$$^2], $CellContext`size$$^2], \
$CellContext`size$$]]; Grid[
         Map[$CellContext`tileButton[#, $CellContext`puzzleGrid, \
$CellContext`tileFaces, $CellContext`showLabels$$, $CellContext`size$$, 
           Enabled -> Not[
             OrderedQ[
              Flatten[$CellContext`puzzleGrid]]], Appearance -> 
           If[$CellContext`noEdges$$, Automatic, 
             "Frameless"]]& , $CellContext`puzzleGrid, {2}], Frame -> All, 
         Spacings -> {1, 1}]), 
      "Specifications" :> {{{$CellContext`size$$, 4}, {3, 4, 5, 6}, 
         ControlType -> 
         PopupMenu}, {{$CellContext`noEdges$$, False, "show edges"}, {
         True, False}, ControlType -> 
         None}, {{$CellContext`showLabels$$, True, "show labels"}, {
         True, False}, ControlType -> None}, 
        Button["Randomise puzzle", $CellContext`puzzleGrid = Partition[
           RandomSample[
            
            Range[$CellContext`size$$^2], $CellContext`size$$^2], \
$CellContext`size$$]]}, "Options" :> {}, "DefaultOptions" :> {}],
     ImageSizeCache->{
      781.4282975360001, {105.81456355720547`, 111.85513964498205`}},
     SingleEvaluation->True],
    Deinitialization:>None,
    DynamicModuleValues:>{},
    Initialization:>((Condition[
         $CellContext`tileButton[
          Pattern[$CellContext`n, 
           Blank[]], 
          Pattern[$CellContext`tile, 
           Blank[]], 
          Blank[], 
          Pattern[$CellContext`opts, 
           BlankNullSequence[]]], $CellContext`n == Max[$CellContext`tile]] := 
       Button[" ", Null, Background -> LightGray, Enabled -> 
         False]; $CellContext`tileButton[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`tile, 
          Blank[]], 
         Pattern[$CellContext`tfc, 
          Blank[]], 
         Pattern[$CellContext`labelsShown, 
          Blank[]], 
         Pattern[$CellContext`size, 
          Blank[]], 
         Pattern[$CellContext`opts, 
          BlankNullSequence[]]] := Button[
         If[$CellContext`labelsShown, 
          Show[
           Graphics[
            Inset[
             Part[$CellContext`tfc, $CellContext`n], {0, 0}, {0, 0}, 1]], 
           Graphics[{
             Text[
              Style[$CellContext`n, (200/$CellContext`size)/2], {0.5, 0.5}]}],
            PlotRange -> {{0, 1}, {0, 1}}, ImageSize -> 
           100/$CellContext`size], 
          Part[$CellContext`tfc, $CellContext`n]], 
         $CellContext`tileMove[$CellContext`n, $CellContext`tile], 
         FrameMargins -> 0, $CellContext`opts]; 
      SetAttributes[$CellContext`tileButton, 
        HoldRest]; $CellContext`borderingSquare[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`tile, 
          Blank[]]] := 
       Module[{$CellContext`posN, $CellContext`posMax, $CellContext`diff}, \
$CellContext`posN = Flatten[
            Position[$CellContext`tile, $CellContext`n]]; $CellContext`posMax = 
          Flatten[
            Position[$CellContext`tile, 
             Max[$CellContext`tile]]]; $CellContext`diff = 
          Abs[$CellContext`posN - $CellContext`posMax]; 
         And[Total[$CellContext`diff] == 1, Count[$CellContext`diff, 1] == 
           1]]; $CellContext`tileMove[
         Pattern[$CellContext`n, 
          Blank[]], 
         Pattern[$CellContext`tile, 
          Blank[]]] := If[
         $CellContext`borderingSquare[$CellContext`n, $CellContext`tile], 
         Unevaluated[$CellContext`tile] = 
         ReplaceAll[$CellContext`tile, {$CellContext`n -> 
            Max[$CellContext`tile], 
            Max[$CellContext`tile] -> $CellContext`n}]]; 
      SetAttributes[$CellContext`tileMove, HoldRest]; Null); 
     Typeset`initDone$$ = True),
    SynchronousInitialization->True,
    UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
    UnsavedVariables:>{Typeset`initDone$$},
    UntrackedVariables:>{Typeset`size$$}], "Manipulate",
   Deployed->True,
   StripOnInput->False],
  Manipulate`InterpretManipulate[1]]], "Output",
 CellChangeTimes->{3.965448759163044*^9},
 CellLabel->
  "Out[138]=",ExpressionUUID->"e9425ba0-486d-1e47-b6bf-d97483e68066"]
}, Open  ]]
}, Open  ]],

