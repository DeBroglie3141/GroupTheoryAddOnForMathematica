     RowBox[{
      StyleBox["        ",
       FontColor->GrayLevel[0.5]], 
      StyleBox[" ",
       FontColor->GrayLevel[0]]}]], 
    StyleBox[
     TemplateBox[<|"boxes" -> FormBox[
         RowBox[{"\[Rho]", ":", 
