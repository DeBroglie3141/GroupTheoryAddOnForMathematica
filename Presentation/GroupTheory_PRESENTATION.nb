Cell[CellGroupData[{

Cell["physics", "Section",
 CellChangeTimes->{
  3.699269664116198*^9, 3.704547485224924*^9, {3.704547522817326*^9, 
   3.704547523721407*^9}, {3.706294282212872*^9, 3.7062943114832697`*^9}, {
   3.965447136381878*^9, 3.965447145073536*^9}, 
   3.9654481109512615`*^9},ExpressionUUID->"4b0e8c2a-f88c-b64e-8831-\
f0d68bad1b65"],

Cell["\<\
Although it is hard to see, groups also play a central role in physics.\
\>", "Text",
 CellChangeTimes->{
  3.6992697457019463`*^9, 3.6992698838436613`*^9, {3.70454744273073*^9, 
   3.704547443267602*^9}, {3.965447400915327*^9, 3.965447404434925*^9}, {
   3.9654474607156887`*^9, 
   3.965447499304497*^9}},ExpressionUUID->"ce3d3638-ad6f-e249-ba31-\
9517b56a7c96"],

Cell["\<\
We may as well cut out group theory. 
That is a subject that will never be of any use in physics.\t\
\>", "Epigraph",
 CellChangeTimes->{
  3.705190309895464*^9, 3.705226861867097*^9, {3.705226913249695*^9, 
   3.7052269330639877`*^9}, 3.705329758876289*^9, 3.707494196439993*^9, {
   3.715687685563108*^9, 3.715687685938055*^9}, {3.965447229507389*^9, 
   3.9654472347751274`*^9}, {3.9654473248088493`*^9, 3.9654473782902813`*^9}},
 TextAlignment->Center,ExpressionUUID->"dd6e460f-1f67-4243-8f4b-9d2f64a26577"],

Cell["Sir James Jeans", "Text",
 CellChangeTimes->{
  3.6992697457019463`*^9, 3.6992698838436613`*^9, {3.70454744273073*^9, 
   3.704547443267602*^9}, {3.965447400915327*^9, 3.965447404434925*^9}, {
   3.9654474607156887`*^9, 3.965447528573923*^9}},
 TextAlignment->Right,ExpressionUUID->"fb3efdca-3607-6b4a-aa38-23db2325b9ad"],

Cell[TextData[StyleBox["Entire structure of the Standard Model of particle \
physics is built from symmetry groups :\n\t- charges of particles\n\t- the \
way forces unify\n\t- possibilities of interactions",
 FontWeight->"Plain"]], "Text",
 CellChangeTimes->{{3.9654475505260773`*^9, 3.965447598411352*^9}, {
  3.9654480441746807`*^9, 3.9654480546806717`*^9}, {3.9654483625965996`*^9, 
  3.9654483706190567`*^9}, {3.965450144578045*^9, 3.965450217306761*^9}},
 FontWeight->"Bold",ExpressionUUID->"9cd37a0a-c1f7-c741-a31d-5a4d31a2edd7"]
}, Open  ]]
}, Open  ]],

