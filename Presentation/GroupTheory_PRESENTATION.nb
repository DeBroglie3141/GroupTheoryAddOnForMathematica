           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Sound", "[", "tones", "]"}]}]}], "\[IndentingNewLine]", 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ToString", "[", "m", "]"}], "<>", "\"\< / GCD(\>\"", "<>", 
       RowBox[{"ToString", "[", "l", "]"}], "<>", "\"\<, \>\"", "<>", 
