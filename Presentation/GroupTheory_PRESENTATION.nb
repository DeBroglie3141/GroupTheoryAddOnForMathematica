Cell[CellGroupData[{

Cell["particle smashing time", "Section",
 CellChangeTimes->{
  3.699269664116198*^9, 3.704547485224924*^9, {3.704547522817326*^9, 
   3.704547523721407*^9}, {3.706294282212872*^9, 3.7062943114832697`*^9}, {
   3.9654499607642174`*^9, 
   3.965449967550913*^9}},ExpressionUUID->"966cc025-0bf4-054d-813d-\
689250b21fa1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", "===", "===", "===", "===", "===", "===", 
    RowBox[{"Electroweak", " ", "backbone", " ", 
     RowBox[{"(", 
      RowBox[{"SU", 
       RowBox[{"(", "2", ")"}], "_L", " ", "x", " ", "U", 
       RowBox[{"(", "1", ")"}], "_Y"}], ")"}]}], "===", "===", "===", "===", "===",
     "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"0", ")"}], " ", "Input", " ", "representations", " ", "for", " ", 
    RowBox[{"leptons", ":", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"T3", ",", "Y"}], ")"}], "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"reps", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<eL\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<T3\>\"", "->", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}]}], ",", 
          RowBox[{"\"\<Y\>\"", "->", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}]}]}], "|>"}]}], ",", 
       RowBox[{"\"\<eR\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<T3\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<Y\>\"", "->", 
           RowBox[{"-", "1"}]}]}], "|>"}]}], ",", 
       RowBox[{"\"\<muL\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<T3\>\"", "->", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}]}], ",", 
          RowBox[{"\"\<Y\>\"", "->", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "2"}]}]}], "|>"}]}], ",", 
       RowBox[{"\"\<muR\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<T3\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<Y\>\"", "->", 
