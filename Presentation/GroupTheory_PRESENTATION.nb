84a003591748"],

Cell[BoxData[
 RowBox[{
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{"\[Psi]", 
        RowBox[{"(", 
          StyleBox["x", "TI"], ")"}], "\[Rule]", 
        SuperscriptBox[
         StyleBox["e", "TI"], 
         RowBox[{
           StyleBox["i", "TI"], 
           StyleBox["q", "TI"], "\[Theta]"}]], "\[Psi]", 
        RowBox[{"(", 
          StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
    "input" -> "\\psi(x)\\to e^{i q \\theta} \\psi(x)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], "-", " ", 
  RowBox[{"similar", " ", "to", " ", "Zn", " ", "representation"}]}]], "Text",
 CellChangeTimes->{{3.965447054891452*^9, 3.965447105776306*^9}},
 FontColor->GrayLevel[
  1],ExpressionUUID->"047af2d0-5ebb-3742-84c0-5f19ac856499"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Point", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "Pi", " ", "I", " ", 
             RowBox[{"n", "/", "k"}]}], "]"}], "]"}], ",", 
          RowBox[{"Im", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{"2", " ", "Pi", " ", "I", " ", 
             RowBox[{"n", "/", "k"}]}], "]"}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", 
         RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"PlotRange", "->", "1.2"}], ",", 
     RowBox[{"Axes", "->", "True"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "1", ",", "1000", ",", "1"}], "}"}]}], "]"}]], "Input",
