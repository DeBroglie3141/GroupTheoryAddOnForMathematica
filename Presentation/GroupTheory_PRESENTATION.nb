Cell[BoxData[{
 RowBox[{
  RowBox[{"s1", "[", "t_", "]"}], ":=", 
  RowBox[{"ScalingTransform", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"2", "t"}], "-", "1"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       SqrtBox["3"]}], ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "2"], ",", 
      FractionBox[
       SqrtBox["3"], "6"]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s2", "[", "t_", "]"}], ":=", 
  RowBox[{"ScalingTransform", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"2", "t"}], "-", "1"}], ",", 
    RowBox[{"{", 
     RowBox[{
      SqrtBox["3"], ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "2"], ",", 
      FractionBox[
       SqrtBox["3"], "6"]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s3", "[", "t_", "]"}], ":=", 
  RowBox[{"ScalingTransform", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"2", "t"}], "-", "1"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "2"], ",", 
      FractionBox[
       SqrtBox["3"], "6"]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r1", "[", "t_", "]"}], ":=", 
  RowBox[{"RotationTransform", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"2", "\[Pi]", " ", "t"}], "3"], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "2"], ",", 
      FractionBox[
       SqrtBox["3"], "6"]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r2", "[", "t_", "]"}], ":=", 
  RowBox[{"RotationTransform", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"4", "t", " ", "\[Pi]"}], "3"], ",", 
    RowBox[{"{", 
     RowBox[{
      FractionBox["1", "2"], ",", 
      FractionBox[
       SqrtBox["3"], "6"]}], "}"}]}], "]"}]}]}], "SideCode",
