Cell[TextData[{
 StyleBox["Definition",
  FontWeight->"Bold"],
 " : Computes the center ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Z", "TI"], "(", 
         StyleBox["G", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "Z(G)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7f52d79-e2fe-8048-a91b-d28c6f4e1a38"],
