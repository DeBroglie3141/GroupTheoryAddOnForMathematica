Cell[TextData[{
 StyleBox["Definition",
  FontWeight->"Bold"],
 " : Returns the identity element of a group or monoid\n",
 StyleBox["Syntax",
  FontWeight->"Bold"],
 " :   ",
 Cell[BoxData[
  RowBox[{"IdentityElement", "[", "group", "]"}]], "InlineCode",
  ExpressionUUID->"08291f7e-36b0-ec44-a2ab-dd1331afb966"],
 "\n",
 StyleBox["Arguments:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9667763754071846`*^9, 3.9667764203440723`*^9}, {
  3.966776483709017*^9, 
  3.9667765147663097`*^9}},ExpressionUUID->"166e9624-9ad8-0446-8720-\
7de7c021c424"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
 "group"], "InlineCode",ExpressionUUID->
  "65e45aad-2bb0-4143-93c5-57c1525ff19c"],
 " --- a group or monoid (e.g. CyclicGroup[n], DihedralGroup[n], \
\[OpenCurlyDoubleQuote]AddMod\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]MultMod\[CloseCurlyDoubleQuote], etc.).\n",
 StyleBox["Returns",
  FontWeight->"Bold"],
 ": The neutral element of the structure."
}], "Subitem",
 CellChangeTimes->{{3.9667765256525593`*^9, 
  3.966776579839216*^9}},ExpressionUUID->"9e135c19-5528-0341-ae0b-\
a1026560eb8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"IdentityElement", "[", "group_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"elems", ",", "n"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Groupes", " ", "finis", " ", "standard"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "CyclicGroup"}], ",", "0",
        ",", 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "DihedralGroup"}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "SymmetricGroup"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AlternatingGroup"}]}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", "PermutationGroup", "*)"}], " ", 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "PermutationGroup"}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", 
       RowBox[{"(*", "AbelianGroup", "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AbelianGroup"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ValueQ", "[", 
           RowBox[{"AbelianGroupQ", "[", "_", "]"}], "]"}], "&&", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"AbelianGroupQ", "[", "group", "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"group", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Zn", ",", "+"}], ")"}], ":", 
         RowBox[{"groupe", " ", "additif", " ", "modulo", " ", "n"}]}], 
        "*)"}], 
       RowBox[{"MatchQ", "[", 
        RowBox[{"group", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<AddMod\>\"", ",", "n_"}], "}"}]}], "]"}], ",", "0", ",",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Zn", ",", "\[Times]"}], ")"}], " ", "mono\[IDoubleDot]de", 
         " ", "ou", " ", "groupe", " ", "multiplicatif"}], "*)"}], 
       RowBox[{"MatchQ", "[", 
        RowBox[{"group", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<MultMod\>\"", ",", "n_"}], "}"}]}], "]"}], ",", "1", ",",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Cas", " ", 
         RowBox[{"g\[EAcute]n\[EAcute]ral", ":", 
          RowBox[{
          "prendre", " ", "le", " ", "premier", " ", 
           "\[EAcute]l\[EAcute]ment", " ", "de", " ", "GroupElements"}]}]}], 
        "*)"}], "True", ",", 
       RowBox[{"First", "[", 
        RowBox[{"GroupElements", "[", "group", "]"}], "]"}]}], "]"}]}], 
    "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.96510152124794*^9, 3.96510152124794*^9}, 
   3.966774627494957*^9, {3.966776644037863*^9, 3.9667766622867584`*^9}, {
   3.966776914325081*^9, 3.966776973629732*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"640f6cb6-ee6b-2648-a90d-93077aa96f29"]
}, Open  ]],

