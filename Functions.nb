 RowBox[{"CayleyMultiplicationTable", "[", "group", 
  "]"}]], "InlineCode",ExpressionUUID->"92fef04e-ef8c-bc47-88a7-4078c1cb7908"]\
], "Subsection",
 CellChangeTimes->{{3.9667763300178223`*^9, 3.966776364462263*^9}, {
  3.966777259453535*^9, 3.9667772702712193`*^9}, {3.966777522208191*^9, 
  3.966777523997593*^9}},ExpressionUUID->"f2beb3b9-c852-5d49-8a46-\
0345c96a926d"],

Cell[TextData[{
 StyleBox["Definition",
  FontWeight->"Bold"],
 " : Constructs the Cayley table of a group or monoid, with the operation \
symbol shown in the top-left corner.\n",
 StyleBox["Syntax",
  FontWeight->"Bold"],
 " :   ",
 Cell[BoxData[
  RowBox[{"CayleyMultiplicationTable", "[", "group", "]"}]], "InlineCode",
  ExpressionUUID->"545edc39-7123-6347-bf44-b7552592dcb4"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.9667763754071846`*^9, 3.9667764203440723`*^9}, {
  3.966776483709017*^9, 3.9667765147663097`*^9}, {3.966777283505348*^9, 
  3.9667773239946327`*^9}, {3.966777529286476*^9, 
  3.9667775480603237`*^9}},ExpressionUUID->"b1752754-f379-e642-b8bd-\
35409a0607a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CayleyMultiplicationTable", "[", "group_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "elements", ",", "Operation", ",", "n", ",", "i", ",", "table", ",", 
       "opSymbol"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "D\[EAcute]tection", " ", "du", " ", "type", " ", "de", " ", "groupe", " ",
        "et", " ", "d\[EAcute]finition", " ", "de", " ", 
       RowBox[{"l", "'"}], "op\[EAcute]ration"}], "*)"}], 
     RowBox[{
      RowBox[{"Which", "[", 
       RowBox[{"(*", 
        RowBox[{"Groupe", " ", "ab\[EAcute]lien"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AbelianGroup"}], ",", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"elements", "=", 
          RowBox[{"Tuples", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"n", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "n", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"x", "+", "y"}], ",", "n"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"\"\<+ (mod \>\"", "<>", 
           RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupe", " ", "cyclique"}], "*)"}], 
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "CyclicGroup"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"x", "+", "y"}], ",", 
            RowBox[{"group", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"\"\<+ (mod \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"group", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupes", " ", "modulaires", " ", "personnalis\[EAcute]s"}],
          "*)"}], 
        RowBox[{"MatchQ", "[", 
         RowBox[{"group", ",", 
          RowBox[{"{", 
           RowBox[{"_String", ",", "_Integer"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<AddMod\>\""}], ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"x", "+", "y"}], ",", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<MultMod\>\""}], ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"x", "*", "y"}], ",", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<AddMod\>\""}], ",", 
            RowBox[{"\"\<+ (mod \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<MultMod\>\""}], ",", 
            RowBox[{"\"\<\[Times] (mod \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}], 
           "]"}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Domaine", " ", "Bool\[EAcute]en"}], "*)"}], 
        RowBox[{"MatchQ", "[", 
         RowBox[{"group", ",", 
          RowBox[{"{", 
           RowBox[{"_String", ",", "_String"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"{", 
           RowBox[{"True", ",", "False"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<And\>\""}], ",", 
            RowBox[{"And", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<Or\>\""}], ",", 
            RowBox[{"Or", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<Xor\>\""}], ",", 
            RowBox[{"Xor", "[", 
             RowBox[{"x", ",", "y"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupes", " ", "de", " ", "permutations"}], "*)"}], 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "DihedralGroup", ",", "SymmetricGroup", ",", "AlternatingGroup", ",",
             "PermutationGroup"}], "}"}], ",", 
          RowBox[{"Head", "[", "group", "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"GroupElements", "[", "group", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"PermutationProduct", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", "\"\<\[SmallCircle]\>\""}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Construction", " ", "de", " ", "la", " ", "table", " ", "avec", " ", 
         "en"}], "-", "t\[EHat]tes"}], "*)"}], 
      RowBox[{"table", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{"#", ",", 
              RowBox[{"elements", "[", 
               RowBox[{"[", 
                RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}]}], "]"}], 
            "&"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Operation", "[", 
              RowBox[{
               RowBox[{"elements", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"elements", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "elements", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "elements", "]"}]}], "}"}]}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{"elements", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"opSymbol", ",", "Bold"}], "]"}]}], "]"}]}], "  ", 
        RowBox[{"(*", 
         RowBox[{
         "Case", " ", "sup\[EAcute]rieure", " ", "gauche", " ", "avec", " ", 
          "couleur"}], "*)"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{"table", ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Spacings", "->", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "\n"}]], "Input",
 CellChangeTimes->{{3.965185406105051*^9, 3.9651854061052094`*^9}, {
  3.9651854385347176`*^9, 3.965185451825367*^9}, {3.96677670386434*^9, 
  3.9667767084295177`*^9}, {3.9667775593658504`*^9, 3.966777564335367*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"8ff1b348-4d5f-5747-9b5f-4fcf8c06c9f2"],

