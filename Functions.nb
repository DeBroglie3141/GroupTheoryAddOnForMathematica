dcb64713623c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Theoretical Background", "Chapter",
 CellChangeTimes->{{3.9667756848494625`*^9, 
  3.9667756901865673`*^9}},ExpressionUUID->"9bbdcfd9-f69d-ac4e-b399-\
f3341f4f9052"],

Cell[TextData[{
 "A  ",
 StyleBox["group",
  FontWeight->"Bold"],
 " is a set  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["G", "TI"], TraditionalForm], "errors" -> {}, "input" -> "G", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6611cbdc-2980-1a48-858c-ea3b6444be48"],
 " with a binary operation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CenterDot]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\cdot", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "657467c4-9275-ee46-9298-0451a963421e"],
 " such that:"
}], "Text",
 CellChangeTimes->{{3.966775725457939*^9, 
  3.966775816564087*^9}},ExpressionUUID->"3fd48728-fea3-de4e-be3e-\
3ee08e1b1a32"],

Cell[TextData[{
 StyleBox["Closure",
  FontWeight->"Bold"],
 ": For all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"], "\[Element]", 
         StyleBox["G", "TI"], ",", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[Element]", 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a, b \\in G, a \\cdot b \\in G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3ffd2447-8af7-1c4b-aae3-fb7928e70920"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.9667758208343105`*^9, 3.966775873748371*^9}, 
   3.9667761091355953`*^9},ExpressionUUID->"bcb0f660-dfea-a54a-8985-\
aa8fe13f5738"],

Cell[TextData[{
 " ",
 StyleBox["Associativity",
  FontWeight->"Bold"],
 ": For all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"], "\[Element]", 
         StyleBox["G", "TI"], ",", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["b", "TI"]}], ")"}], "\[CenterDot]", 
         StyleBox["c", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["b", "TI"], "\[CenterDot]", 
             StyleBox["c", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "a, b \\in G, (a \\cdot b) \\cdot c = a \\cdot (b \\cdot c)",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "74a6c054-e718-554d-bb0a-d650e07778b9"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.9667758208343105`*^9, 3.966775873021263*^9}, {
   3.966775903968321*^9, 3.9667759216069508`*^9}, {3.9667759635702744`*^9, 
   3.966775963572489*^9}, 
   3.9667761082183456`*^9},ExpressionUUID->"bdabe13c-272e-f346-83c8-\
ce9bddc87d49"],

Cell[TextData[{
 StyleBox["Identity",
  FontWeight->"Bold"],
 ": There exists an element ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], "\[Element]", 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e \\in G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "21e3b033-e596-ce47-96b6-c48c36064fd0"],
 " such that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["e", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e \\cdot a = a \\cdot e = a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae0b44f7-c177-ef48-a288-e874b7bc75d6"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Element]", 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\in G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3071427-ce96-e746-8976-f8bd3d48124b"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.9667758208343105`*^9, 3.966775873021263*^9}, {
   3.966775903968321*^9, 3.9667759216069508`*^9}, {3.966775965450077*^9, 
   3.9667760371326275`*^9}, 
   3.966776105865*^9},ExpressionUUID->"77155ed6-b4e9-d148-af87-8c8ddeb28f10"],

Cell[TextData[{
 StyleBox["Inverse",
  FontWeight->"Bold"],
 ": For each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Element]", 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\in G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85c418f5-1468-964e-b201-c51353934df9"],
 ", there exists ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "-1"], "\[Element]", 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^{-1} \\in G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "601f6878-6f5f-9242-b1a2-538e22a102b5"],
 " such that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "-1"], "\[LongEqual]", 
         StyleBox["e", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\cdot a^{-1} = e", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53e3f224-660c-b146-9afc-a8bedc1c3bc0"],
 "."
}], "ItemNumbered",
 CellChangeTimes->{{3.9667758208343105`*^9, 3.966775873021263*^9}, {
  3.966775903968321*^9, 3.9667759216069508`*^9}, {3.966775965450077*^9, 
  3.966776114821991*^9}},ExpressionUUID->"48523a88-c46a-8e48-ac10-\
5db5c2b2f669"],

Cell[TextData[{
 "A group is ",
 StyleBox["abelian",
  FontWeight->"Bold"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["b", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a \\cdot b = b \\cdot a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb2cac75-0663-7b4b-8589-427289babd75"],
 " for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"], "\[Element]", 
         StyleBox["G", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a, b \\in G", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91e7f153-8eb0-de4a-95c3-6ef95240e984"],
 "."
}], "Text",
 CellChangeTimes->{{3.966776121379833*^9, 
  3.9667761561820965`*^9}},ExpressionUUID->"649656d2-5f64-cc4f-a32a-\
7612e925c551"],

Cell[TextData[{
 "The ",
 StyleBox["center",
  FontWeight->"Bold"],
 " of a group ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Z", "TI"], "(", 
         StyleBox["G", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "Z(G)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ea10945-6605-5848-b5a1-82ce28af2eda"],
 " is the set of all elements that commute with every element in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["G", "TI"], TraditionalForm], "errors" -> {}, "input" -> "G", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3c98d21-159a-3444-9213-a6146d7d51f3"],
 "."
}], "Text",
 CellChangeTimes->{{3.9667761738928185`*^9, 
  3.9667762263758583`*^9}},ExpressionUUID->"239c25f6-ea5a-764a-a551-\
5e24139093cb"],

Cell[TextData[{
 "The ",
 StyleBox["Cayley Table ",
  FontWeight->"Bold"],
 "is a tabular representation of the group operation.\n"
}], "Text",
 CellChangeTimes->{{3.9667762357841835`*^9, 
  3.9667762639288845`*^9}},ExpressionUUID->"6486a745-b45f-0742-aed0-\
