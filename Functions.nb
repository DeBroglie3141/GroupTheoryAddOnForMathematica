  RowBox[{"(*", "0", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"IdentityElement", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<MultMod\>\"", ",", "8"}], "}"}], "]"}], "          ", 
  RowBox[{"(*", "1", "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{3.966776647927456*^9},
