Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IdentityElement", "[", "group_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"elems", ",", "n"}], "}"}], ",", 
     RowBox[{"Which", "[", 
      RowBox[{"(*", 
       RowBox[{"Groupes", " ", "finis", " ", "standard"}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "CyclicGroup"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "QuaternionGroup"}]}], ",",
        "0", ",", 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "DihedralGroup"}], ",", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "SymmetricGroup"}], "||", 
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AlternatingGroup"}]}], ",", 
       RowBox[{"Cycles", "[", 
        RowBox[{"{", "}"}], "]"}], ",", 
       RowBox[{"(*", "PermutationGroup", "*)"}], 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "PermutationGroup"}], ",", 
       RowBox[{"IdentityPermutation", "[", 
        RowBox[{"Max", "[", 
         RowBox[{"Length", "/@", 
          RowBox[{"GroupElements", "[", "group", "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "MatrixGroup", " ", "ou", " ", "groupes", " ", "classiques", " ", 
         "de", " ", "matrices"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "MatrixGroup"}], "||", 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"SpecialUnitaryGroup", ",", "SpecialOrthogonalGroup"}], 
           "}"}], ",", 
          RowBox[{"Head", "[", "group", "]"}]}], "]"}]}], ",", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", 
         RowBox[{
          RowBox[{"GroupElements", "[", "group", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"(*", "AbelianGroup", "*)"}], 
       RowBox[{
        RowBox[{"Head", "[", "group", "]"}], "===", "AbelianGroup"}], ",", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"group", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Zn", ",", "+"}], ")"}], ":", 
         RowBox[{"groupe", " ", "additif", " ", "modulo", " ", "n"}]}], 
        "*)"}], 
       RowBox[{"MatchQ", "[", 
        RowBox[{"group", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<AddMod\>\"", ",", "n_"}], "}"}]}], "]"}], ",", "0", ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Zn", ",", "\[Times]"}], ")"}], " ", "mono\[IDoubleDot]de", 
         " ", "ou", " ", "groupe", " ", "multiplicatif"}], "*)"}], 
       RowBox[{"MatchQ", "[", 
        RowBox[{"group", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<MultMod\>\"", ",", "n_"}], "}"}]}], "]"}], ",", "1", ",", 
       RowBox[{"(*", 
        RowBox[{"Cas", " ", 
         RowBox[{"g\[EAcute]n\[EAcute]ral", ":", 
          RowBox[{
          "prendre", " ", "le", " ", "premier", " ", 
           "\[EAcute]l\[EAcute]ment", " ", "de", " ", "GroupElements"}]}]}], 
        "*)"}], "True", ",", 
       RowBox[{"First", "[", 
        RowBox[{"GroupElements", "[", "group", "]"}], "]"}]}], "]"}]}], 
    "]"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Exemples", " ", 
    RowBox[{"d", "'"}], 
    RowBox[{"utilisation", ":"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IdentityElement", "[", 
   RowBox[{"CyclicGroup", "[", "5", "]"}], "]"}], "          ", 
  RowBox[{"(*", "0", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"IdentityElement", "[", 
   RowBox[{"SymmetricGroup", "[", "3", "]"}], "]"}], "       ", 
  RowBox[{"(*", 
   RowBox[{"PermutationCycles", "[", "]"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"IdentityElement", "[", 
   RowBox[{"AbelianGroup", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "3"}], "}"}], "]"}], "]"}], "    ", 
  RowBox[{"(*", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"IdentityElement", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<AddMod\>\"", ",", "7"}], "}"}], "]"}], "           ", 
  RowBox[{"(*", "0", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"IdentityElement", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<MultMod\>\"", ",", "8"}], "}"}], "]"}], "          ", 
  RowBox[{"(*", "1", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.96510152124794*^9, 3.96510152124794*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"640f6cb6-ee6b-2648-a90d-93077aa96f29"],

