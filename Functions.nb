  RowBox[{"GroupCenter", "[", "group", "]"}]], "InlineCode",ExpressionUUID->
  "6482cb19-f21f-474c-8eff-0da229717155"],
 "\n",
 StyleBox["Returns",
  FontWeight->"Bold"],
 ": A list of elements in the center."
}], "Text",
 CellChangeTimes->{{3.9667763754071846`*^9, 3.9667764203440723`*^9}, {
