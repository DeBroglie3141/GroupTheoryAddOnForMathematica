Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CayleyMultiplicationTable", "[", "group_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "elements", ",", "Operation", ",", "n", ",", "i", ",", "table", ",", 
       "opSymbol"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "D\[EAcute]tection", " ", "du", " ", "type", " ", "de", " ", "groupe", " ",
        "et", " ", "d\[EAcute]finition", " ", "de", " ", 
       RowBox[{"l", "'"}], "op\[EAcute]ration"}], "*)"}], 
     RowBox[{
      RowBox[{"Which", "[", 
       RowBox[{"(*", 
        RowBox[{"Groupe", " ", "ab\[EAcute]lien"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "AbelianGroup"}], ",", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"elements", "=", 
          RowBox[{"Tuples", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"n", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", "1"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "n", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"x", "+", "y"}], ",", "n"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"\"\<+ (mod \>\"", "<>", 
           RowBox[{"ToString", "[", "n", "]"}], "<>", "\"\<)\>\""}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupe", " ", "cyclique"}], "*)"}], 
        RowBox[{
         RowBox[{"Head", "[", "group", "]"}], "===", "CyclicGroup"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"x", "+", "y"}], ",", 
            RowBox[{"group", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"\"\<+ (mod \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"group", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupes", " ", "modulaires", " ", "personnalis\[EAcute]s"}],
          "*)"}], 
        RowBox[{"MatchQ", "[", 
         RowBox[{"group", ",", 
          RowBox[{"{", 
           RowBox[{"_String", ",", "_Integer"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<AddMod\>\""}], ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"x", "+", "y"}], ",", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<MultMod\>\""}], ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"x", "*", "y"}], ",", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<AddMod\>\""}], ",", 
            RowBox[{"\"\<+ (mod \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<MultMod\>\""}], ",", 
            RowBox[{"\"\<\[Times] (mod \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"group", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<)\>\""}]}], 
           "]"}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Domaine", " ", "Bool\[EAcute]en"}], "*)"}], 
        RowBox[{"MatchQ", "[", 
         RowBox[{"group", ",", 
          RowBox[{"{", 
           RowBox[{"_String", ",", "_String"}], "}"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"{", 
           RowBox[{"True", ",", "False"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<And\>\""}], ",", 
            RowBox[{"And", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<Or\>\""}], ",", 
            RowBox[{"Or", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", 
            RowBox[{
             RowBox[{"group", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "==", "\"\<Xor\>\""}], ",", 
            RowBox[{"Xor", "[", 
             RowBox[{"x", ",", "y"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", 
          RowBox[{"group", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Groupes", " ", "de", " ", "permutations"}], "*)"}], 
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "DihedralGroup", ",", "SymmetricGroup", ",", "AlternatingGroup", ",",
             "PermutationGroup"}], "}"}], ",", 
          RowBox[{"Head", "[", "group", "]"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"elements", "=", 
          RowBox[{"GroupElements", "[", "group", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Operation", "[", 
           RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
          RowBox[{"PermutationProduct", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"opSymbol", "=", "\"\<\[SmallCircle]\>\""}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Construction", " ", "de", " ", "la", " ", "table", " ", "avec", " ", 
         "en"}], "-", "t\[EHat]tes"}], "*)"}], 
      RowBox[{"table", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{"#", ",", 
              RowBox[{"elements", "[", 
               RowBox[{"[", 
                RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}]}], "]"}], 
            "&"}], ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Operation", "[", 
              RowBox[{
               RowBox[{"elements", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"elements", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "elements", "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", 
               RowBox[{"Length", "[", "elements", "]"}]}], "}"}]}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"Prepend", "[", 
          RowBox[{"elements", ",", 
           RowBox[{"Style", "[", 
            RowBox[{"opSymbol", ",", "Bold"}], "]"}]}], "]"}]}], "  ", 
        RowBox[{"(*", 
         RowBox[{
         "Case", " ", "sup\[EAcute]rieure", " ", "gauche", " ", "avec", " ", 
          "couleur"}], "*)"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Grid", "[", 
       RowBox[{"table", ",", 
        RowBox[{"Frame", "->", "All"}], ",", 
        RowBox[{"Spacings", "->", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Exemples", " ", 
    RowBox[{"d", "'"}], "utilisation"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"CayleyMultiplicationTable", "[", 
  RowBox[{"AbelianGroup", "[", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], "]"}], "]"}], "\n", 
 RowBox[{"CayleyMultiplicationTable", "[", 
